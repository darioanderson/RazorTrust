RAZORTRUST_ENV=development
RAZORTRUST_POLICY_MODE=opa
RAZORTRUST_OPA_URL=http://localhost:8181
RAZORTRUST_LEDGER_PATH=var/audit.jsonl
RAZORTRUST_MODEL_RELEASE_PATH=
RAZORTRUST_MODEL_PUBLIC_KEY=
# model = require a signed verified model outside development; human_only = never auto-RELEASE
RAZORTRUST_DECISION_MODE=model
RAZORTRUST_AUTHORIZATION_REQUIRED=false
RAZORTRUST_AUTHORIZATION_MODE=local
RAZORTRUST_API_PRINCIPALS={}
RAZORTRUST_EVIDENCE_PUBLIC_KEYS={}
RAZORTRUST_TRUSTED_HOSTS=localhost,127.0.0.1
RAZORTRUST_RATE_LIMIT_PER_MINUTE=120
RAZORTRUST_SECURITY_HEADERS_ENABLED=true
RAZORTRUST_DATABASE_URL=postgresql+asyncpg://razortrust:replace-me@localhost:5432/razortrust
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_DSN=

# Razorpay integration (start in Test Mode)
RAZORTRUST_RAZORPAY_ENABLED=false
RAZORTRUST_RAZORPAY_MODE=test
RAZORTRUST_RAZORPAY_KEY_ID=
RAZORTRUST_RAZORPAY_KEY_SECRET=
RAZORTRUST_RAZORPAY_WEBHOOK_SECRET=
RAZORTRUST_RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Sensitive settings also support an exclusive *_FILE form for secret mounts.

# Safe automatic orchestration: evaluates persisted OPEN holds; never moves money.
RAZORTRUST_AUTOMATION_ENABLED=false
RAZORTRUST_AUTOMATION_INTERVAL_SECONDS=60
